# Normalize all text files to LF in repo; encoding is always UTF-8 (see .editorconfig)
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binaries — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
