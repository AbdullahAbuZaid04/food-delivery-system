PORT=5000

DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/food_delivery_system"

# Access token secret (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Refresh token secret — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=1d

REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:3000
