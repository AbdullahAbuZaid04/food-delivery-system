PORT=5000

# ── Database (Supabase) ──────────────────────────────────────
# Transaction-mode pooler — use for normal queries
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler — use for migrations (npx prisma migrate)
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────
# Access token secret (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# Refresh token secret — MUST be different from JWT_SECRET
JWT_REFRESH_SECRET=

JWT_EXPIRES_IN=1d

REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins (no trailing slash)
# Production: https://YOUR_VERCEL_APP.vercel.app
CORS_ORIGINS=http://localhost:3000
